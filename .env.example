# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is gitignored for a reason.

# Solana RPC endpoint (e.g. https://api.devnet.solana.com)
# SOLANA_RPC_URL=

# Filesystem path to the oracle's signing keypair (JSON keypair file)
# ORACLE_KEYPAIR_PATH=

# Deployed randomness-beacon program ID (base58)
# PROGRAM_ID=

# BN254 Fr scalar, hex-encoded; generate with [TODO: command]
# ORACLE_VRF_SECRET=

# Path to the prover binary (default: target/release/prover or target/debug/prover)
# PROVER_BINARY_PATH=

# Path to the Groth16 proving key (default: artifacts/proving_key.bin)
# PROVING_KEY_PATH=
